APP_ENV=production
STORE_NAME=My Store
ORDER_NUMBER_PREFIX=CK
SHIPPING_PRICING_MODE=free
NEXT_PUBLIC_STORE_NAME=My Store
DATABASE_URL=postgresql+asyncpg://xvond_store:REPLACE_PASSWORD@postgres:5432/xvond_store
DATABASE_RESIDENCY_COUNTRY=OM
POSTGRES_PASSWORD=REPLACE_PASSWORD
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_48_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=REPLACE_WITH_OPERATOR_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTERS
PENDING_ORDER_HOLD_MINUTES=30
FRONTEND_URL=https://store.example.com
PUBLIC_API_URL=https://store.example.com/api/v1
EMAIL_FROM=Store Notifications <no-reply@example.com>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=REPLACE_WITH_ZOHO_APP_PASSWORD
SMTP_STARTTLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://store.example.com/api/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://store.example.com/api/v1/auth/apple/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://store.example.com/api/v1/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TAP_ENABLED=false
TAP_SECRET_KEY=REPLACE_WITH_TAP_LIVE_SECRET_KEY
TAP_MERCHANT_ID=REPLACE_WITH_TAP_MERCHANT_ID
TAP_SOURCE_ID=src_all
TAP_WEBHOOK_URL=https://store.example.com/api/v1/payments/tap/webhook
CORS_ORIGINS=https://store.example.com
NEXT_PUBLIC_API_URL=https://store.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://store.example.com
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_IMAGE_HOSTNAME=images.example.com
